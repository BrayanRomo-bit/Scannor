# ================================================================
# Configuración del Microservicio de Conteo de Peones
# ================================================================

# Ruta y tipo de modelo (detección o segmentación)
MODEL_PATH=weights/best_peones.pt
MODEL_TYPE=detection

# Umbrales de inferencia y configuración de ByteTrack
CONFIDENCE_THRESHOLD=0.50
IOU_THRESHOLD=0.45
TRACKER_CONFIG_PATH=bytetrack.yaml
DEVICE=cpu

# Línea virtual de conteo en la banda transportadora (coordenadas relativas 0.0 - 1.0)
LINE_START_X=0.10
LINE_START_Y=0.50
LINE_END_X=0.90
LINE_END_Y=0.50

# Clases a contabilizar (dejar vacío o * para contar todas las clases del modelo)
TARGET_CLASSES=peon,pawn,peon_blanco,peon_negro

# Parámetros del servidor HTTP
HOST=0.0.0.0
PORT=8003
