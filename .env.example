# ==========================================
# ScannorQA - Plantilla de Variables (.env.example)
# Copiar a .env y completar con valores reales
# ==========================================

# --- Django Core ---
SECRET_KEY=cambiar-por-clave-secreta-segura
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
LANGUAGE_CODE=es-mx
TIME_ZONE=America/Mexico_City
DATA_UPLOAD_MAX_MEMORY_SIZE=104857600
FILE_UPLOAD_MAX_MEMORY_SIZE=104857600

# --- Base de Datos ---
DB_ENGINE=django.db.backends.sqlite3
SQLITE_NAME=db.sqlite3
DB_NAME=scannorqa_db
DB_USER=postgres
DB_PASSWORD=cambiar-por-password-seguro
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Red Central / Provisionamiento ---
DJANGO_BASE_URL=http://localhost:8000
DJANGO_API_URL=http://localhost:8000/api/guardar-falla/
CENTRAL_PROVISION_URL=http://localhost:8000/api/provisionar/
DEFAULT_EDGE_HOST=127.0.0.1
DNS_PROBE_IP=8.8.8.8
DNS_PROBE_PORT=80

# --- Puertos de Microservicios Edge ---
PORT_DEFECT_INSPECTION=8001
PORT_INVENTORY_COUNTING=8002
PORT_PAWN_COUNTER=8003
PORT_API_VISION=8001

# --- Motor de Vision / Gateway ---
HOST=0.0.0.0
LOG_LEVEL=info
CONF_THRESHOLD=0.25
CAMERA_CONFIG_FILE=config_camaras.json
SCANNOR_CAPTURES_DIR=capturas_falla
SCANNOR_OFFLINE_DB=scannor_offline.db

# --- Credenciales Nodo Edge (Generadas por Provisionamiento) ---
SCANNOR_DEVICE_ID=
SCANNOR_DEVICE_KEY=
SCANNOR_API_KEY=
SCANNOR_STREAM_TOKEN=

# --- Roboflow ---
ROBOFLOW_API_KEY=tu_api_key_de_roboflow
ROBOFLOW_WORKSPACE=tu-workspace
ROBOFLOW_PROJECT=scannor-qa-ladrillos

